       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="userService" class="com.example.xmlConfiguration.UserService">
        <constructor-arg name="userNames">
            <list>
                <value>Kartikey</value>
                <value>Rohit</value>
                <value>Harshit</value>
                <value>Aman</value>
            </list>
        </constructor-arg>
    </bean>
</beans>